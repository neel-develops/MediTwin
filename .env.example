# Copy to .env (in the project root or backend/) and adjust. Every setting is optional.

# SQLite database file (default: backend/data/meditwin.db)
# MEDITWIN_DB=backend/data/meditwin.db

# Seed fictional demo data when the database is empty (1 = yes, 0 = no)
# MEDITWIN_SEED_ON_START=1

# Optional: power the MediTwin AI assistant with Groq (GPT-OSS 120B). Get a key at
# https://console.groq.com/keys. Without a key the assistant uses the built-in offline
# engine, and every other AI feature works the same.
# GROQ_API_KEY=
# MEDITWIN_AI_MODEL=openai/gpt-oss-120b
